        let cx = 20.0@worker3 + 60.0@worker3 * ((c % 2@worker3) as float);
        let cy = 20.0@worker3 + 60.0@worker3 * ((c / 2@worker3) as float);
        s = (s * 75@worker3 + 74@worker3) % 65537@worker3;
        let dx = (s as float) / 65537.0@worker3 * 24.0@worker3 - 12.0@worker3;
        s = (s * 75@worker3 + 74@worker3) % 65537@worker3;
        let dy = (s as float) / 65537.0@worker3 * 24.0@worker3 - 12.0@worker3;
