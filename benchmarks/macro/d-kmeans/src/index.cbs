// D kmeans: distributed k-means clustering (Lloyd's algorithm) with restarts.
//
// Endpoints: coordinator, worker1, worker2, worker3, worker4.
//
// Each worker holds its own share of the points, flattened as a `float[]`.
// Each iteration:
//
//   1. the coordinator broadcasts the centroids;
//   2. each worker assigns its points to the nearest centroid and sends back
//      per-cluster sums, counts and its share of the inertia;
//   3. the coordinator reduces the partials, moves the centroids, and
//      broadcasts whether any centroid still moves, which drives the loop.
//
// The whole clustering is restarted RESTARTS times from fresh random
// centroids, and the best inertia is kept. The assignment pass is a local
// kernel at each worker; the reduction, the centroid update and the
// convergence test are choreography code at the coordinator.
//
// Self-check: within each restart the inertia never increases (up to float
// rounding), and the best inertia is below a bound that only a good
// clustering meets. All values are floats: compare checksums with a tolerance
// (see benchmarks/README.md).
//
// Output: the coordinator prints `ok`, the best inertia and the total number
// of iterations.

// ---------------------------------------------------------------------------
// Workload
// ---------------------------------------------------------------------------

let POINTS: integer@every = 200@every;
let K: integer@every = 4@every;
let MAX_ITERS: integer@every = 20@every;
let RESTARTS: integer@every = 4@every;

// ---------------------------------------------------------------------------
// worker1: local kernels
// ---------------------------------------------------------------------------

// n points around four true centres, flattened as [x0, y0, x1, y1, ...].
function makePoints1@worker1(n: integer@worker1, seed: integer@worker1): float[]@worker1 {
    let xs: float[]@worker1 = []@worker1;
    let s = seed;
    for (let i = 0@worker1; i < n; i = i + 1@worker1) {
        s = (s * 75@worker1 + 74@worker1) % 65537@worker1;
        let c = s % 4@worker1;
        let cx = 20.0@worker1 + 60.0@worker1 * ((c % 2@worker1) as float);
        let cy = 20.0@worker1 + 60.0@worker1 * ((c / 2@worker1) as float);
        s = (s * 75@worker1 + 74@worker1) % 65537@worker1;
        let dx = (s as float) / 65537.0@worker1 * 24.0@worker1 - 12.0@worker1;
        s = (s * 75@worker1 + 74@worker1) % 65537@worker1;
        let dy = (s as float) / 65537.0@worker1 * 24.0@worker1 - 12.0@worker1;
        xs.push(cx + dx);
        xs.push(cy + dy);
    }
    return xs;
}

// One assignment pass. The result holds, for each cluster j, the sums of x
// and y and the count at 3j, 3j+1 and 3j+2, and the inertia at 3k.
function assign1@worker1(points: float[]@worker1, centroids: float[]@worker1, k: integer@worker1): float[]@worker1 {
    let part: float[]@worker1 = []@worker1;
    for (let j = 0@worker1; j < k * 3@worker1 + 1@worker1; j = j + 1@worker1) {
        part.push(0.0@worker1);
    }
    let n = points.length / 2@worker1;
    for (let i = 0@worker1; i < n; i = i + 1@worker1) {
        let x = points[2@worker1 * i];
        let y = points[2@worker1 * i + 1@worker1];
        let best = 0@worker1;
        let bestD = 1000000.0@worker1;
        for (let j = 0@worker1; j < k; j = j + 1@worker1) {
            let dx = x - centroids[2@worker1 * j];
            let dy = y - centroids[2@worker1 * j + 1@worker1];
            let d = dx * dx + dy * dy;
            if (d < bestD) {
                bestD = d;
                best = j;
            }
        }
        part[3@worker1 * best] = part[3@worker1 * best] + x;
        part[3@worker1 * best + 1@worker1] = part[3@worker1 * best + 1@worker1] + y;
        part[3@worker1 * best + 2@worker1] = part[3@worker1 * best + 2@worker1] + 1.0@worker1;
        part[3@worker1 * k] = part[3@worker1 * k] + bestD;
    }
    return part;
}

// ---------------------------------------------------------------------------
// worker2: local kernels
// ---------------------------------------------------------------------------

// n points around four true centres, flattened as [x0, y0, x1, y1, ...].
function makePoints2@worker2(n: integer@worker2, seed: integer@worker2): float[]@worker2 {
    let xs: float[]@worker2 = []@worker2;
    let s = seed;
    for (let i = 0@worker2; i < n; i = i + 1@worker2) {
        s = (s * 75@worker2 + 74@worker2) % 65537@worker2;
        let c = s % 4@worker2;
        let cx = 20.0@worker2 + 60.0@worker2 * ((c % 2@worker2) as float);
        let cy = 20.0@worker2 + 60.0@worker2 * ((c / 2@worker2) as float);
        s = (s * 75@worker2 + 74@worker2) % 65537@worker2;
        let dx = (s as float) / 65537.0@worker2 * 24.0@worker2 - 12.0@worker2;
        s = (s * 75@worker2 + 74@worker2) % 65537@worker2;
        let dy = (s as float) / 65537.0@worker2 * 24.0@worker2 - 12.0@worker2;
        xs.push(cx + dx);
        xs.push(cy + dy);
    }
    return xs;
}

// One assignment pass. The result holds, for each cluster j, the sums of x
// and y and the count at 3j, 3j+1 and 3j+2, and the inertia at 3k.
function assign2@worker2(points: float[]@worker2, centroids: float[]@worker2, k: integer@worker2): float[]@worker2 {
    let part: float[]@worker2 = []@worker2;
    for (let j = 0@worker2; j < k * 3@worker2 + 1@worker2; j = j + 1@worker2) {
        part.push(0.0@worker2);
    }
    let n = points.length / 2@worker2;
    for (let i = 0@worker2; i < n; i = i + 1@worker2) {
        let x = points[2@worker2 * i];
        let y = points[2@worker2 * i + 1@worker2];
        let best = 0@worker2;
        let bestD = 1000000.0@worker2;
        for (let j = 0@worker2; j < k; j = j + 1@worker2) {
            let dx = x - centroids[2@worker2 * j];
            let dy = y - centroids[2@worker2 * j + 1@worker2];
            let d = dx * dx + dy * dy;
            if (d < bestD) {
                bestD = d;
                best = j;
            }
        }
        part[3@worker2 * best] = part[3@worker2 * best] + x;
        part[3@worker2 * best + 1@worker2] = part[3@worker2 * best + 1@worker2] + y;
        part[3@worker2 * best + 2@worker2] = part[3@worker2 * best + 2@worker2] + 1.0@worker2;
        part[3@worker2 * k] = part[3@worker2 * k] + bestD;
    }
    return part;
}

// ---------------------------------------------------------------------------
// worker3: local kernels
// ---------------------------------------------------------------------------

// n points around four true centres, flattened as [x0, y0, x1, y1, ...].
function makePoints3@worker3(n: integer@worker3, seed: integer@worker3): float[]@worker3 {
    let xs: float[]@worker3 = []@worker3;
    let s = seed;
    for (let i = 0@worker3; i < n; i = i + 1@worker3) {
        s = (s * 75@worker3 + 74@worker3) % 65537@worker3;
