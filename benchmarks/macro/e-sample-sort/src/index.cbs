// In-place quicksort of xs[lo..hi] (Lomuto partition).
function sort4@worker4(xs: integer[]@worker4, lo: integer@worker4, hi: integer@worker4): void {
    if (lo < hi) {
        let pivot = xs[hi];
        let i = lo;
        for (let j = lo; j < hi; j = j + 1@worker4) {
            if (xs[j] < pivot) {
                let t = xs[i];
                xs[i] = xs[j];
                xs[j] = t;
                i = i + 1@worker4;
            }
        }
        let t = xs[i];
