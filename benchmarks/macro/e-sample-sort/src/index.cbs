    return out;
}

// The elements of bucket b (1-based): those v with splitters[b-2] <= v < splitters[b-1].
function bucket2@worker2(xs: integer[]@worker2, splitters: integer[]@worker2, b: integer@worker2): integer[]@worker2 {
    let lo = -1@worker2;
    if (b > 1@worker2) {
        lo = splitters[b - 2@worker2];
    }
    let hi = 1000000@worker2;
    if (b <= splitters.length) {
        hi = splitters[b - 1@worker2];
    }
    let out: integer[]@worker2 = []@worker2;
    for (let i = 0@worker2; i < xs.length; i = i + 1@worker2) {
        let v = xs[i];
        if (v >= lo && v < hi) {
            out.push(v);
        }
    }
    return out;
}

function isSorted2@worker2(xs: integer[]@worker2): boolean@worker2 {
    let sorted = true@worker2;
    for (let i = 1@worker2; i < xs.length; i = i + 1@worker2) {
        if (xs[i - 1@worker2] > xs[i]) {
            sorted = false@worker2;
        }
    }
    return sorted;
}

function checksum2@worker2(xs: integer[]@worker2): integer@worker2 {
    let sum = 0@worker2;
    for (let i = 0@worker2; i < xs.length; i = i + 1@worker2) {
        sum = (sum + xs[i]) % 1000003@worker2;
    }
    return sum;
}

// The smallest element, or 1000000 for an empty array.
function lowest2@worker2(xs: integer[]@worker2): integer@worker2 {
    if (xs.length === 0@worker2) {
        return 1000000@worker2;
    }
    return xs[0@worker2];
}

// The largest element of a sorted array, or -1 for an empty one.
function highest2@worker2(xs: integer[]@worker2): integer@worker2 {
    if (xs.length === 0@worker2) {
        return -1@worker2;
    }
    return xs[xs.length - 1@worker2];
}

