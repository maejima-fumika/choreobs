// m evenly spaced elements of a sorted array.
function sample4@worker4(xs: integer[]@worker4, m: integer@worker4): integer[]@worker4 {
    let out: integer[]@worker4 = []@worker4;
    for (let i = 0@worker4; i < m; i = i + 1@worker4) {
        out.push(xs[(i * xs.length) / m]);
    }
    return out;
}

// The elements of bucket b (1-based): those v with splitters[b-2] <= v < splitters[b-1].
function bucket4@worker4(xs: integer[]@worker4, splitters: integer[]@worker4, b: integer@worker4): integer[]@worker4 {
    let lo = -1@worker4;
    if (b > 1@worker4) {
        lo = splitters[b - 2@worker4];
    }
    let hi = 1000000@worker4;
    if (b <= splitters.length) {
        hi = splitters[b - 1@worker4];
    }
    let out: integer[]@worker4 = []@worker4;
    for (let i = 0@worker4; i < xs.length; i = i + 1@worker4) {
        let v = xs[i];
        if (v >= lo && v < hi) {
            out.push(v);
        }
