// E sample-sort: distributed sample sort with an all-to-all exchange.
//
// Endpoints: coordinator, worker1, worker2, worker3, worker4.
//
// Each round, every worker generates N_PER_WORKER fresh integers and:
//
//   1. sorts them locally and sends SAMPLES evenly spaced ones to the
//      coordinator;
//   2. the coordinator merges the samples, picks three splitters and
//      broadcasts them as an `integer[]@every`;
//   3. each worker cuts its sorted data into four buckets by the splitters;
//   4. all-to-all: worker i sends bucket j to worker j, twelve array
//      transfers in all;
//   5. each worker merges the four buckets it now holds.
//
// Sorting, cutting and merging are local kernels; sampling, splitter choice,
// the exchange and the audit are choreography code. Most of the bytes that
// move are whole arrays, so array transfers and copies dominate.
//
// Self-check, every round: each worker's result is sorted, the ranges are
// ordered across workers, no element was lost, and the element checksum is
// conserved.
//
// Output: the coordinator prints `ok` and a checksum over all rounds.

// ---------------------------------------------------------------------------
// Workload
// ---------------------------------------------------------------------------

let N_PER_WORKER: integer@every = 100@every;
let SAMPLES: integer@every = 16@every;
let ROUNDS: integer@every = 5@every;

// ---------------------------------------------------------------------------
// worker1: local kernels
// ---------------------------------------------------------------------------

function makeData1@worker1(n: integer@worker1, seed: integer@worker1): integer[]@worker1 {
    let xs: integer[]@worker1 = []@worker1;
    let s = seed % 65537@worker1;
    for (let i = 0@worker1; i < n; i = i + 1@worker1) {
        s = (s * 75@worker1 + 74@worker1) % 65537@worker1;
        let hi = s;
        s = (s * 75@worker1 + 74@worker1) % 65537@worker1;
        xs.push((hi * 16@worker1 + s % 16@worker1) % 1000000@worker1);
    }
    return xs;
}

// In-place quicksort of xs[lo..hi] (Lomuto partition).
function sort1@worker1(xs: integer[]@worker1, lo: integer@worker1, hi: integer@worker1): void {
    if (lo < hi) {
        let pivot = xs[hi];
        let i = lo;
        for (let j = lo; j < hi; j = j + 1@worker1) {
            if (xs[j] < pivot) {
                let t = xs[i];
                xs[i] = xs[j];
                xs[j] = t;
                i = i + 1@worker1;
            }
        }
        let t = xs[i];
        xs[i] = xs[hi];
        xs[hi] = t;
        sort1(xs, lo, i - 1@worker1);
        sort1(xs, i + 1@worker1, hi);
    }
}

// The merge of two sorted arrays, as a fresh array.
function merge1@worker1(a: integer[]@worker1, b: integer[]@worker1): integer[]@worker1 {
    let out: integer[]@worker1 = []@worker1;
    let i = 0@worker1;
    let j = 0@worker1;
    while (i < a.length || j < b.length) {
        let takeA = j >= b.length;
        if (i < a.length && j < b.length) {
            takeA = a[i] <= b[j];
        }
        if (takeA) {
            out.push(a[i]);
            i = i + 1@worker1;
        } else {
            out.push(b[j]);
            j = j + 1@worker1;
        }
    }
    return out;
}

// m evenly spaced elements of a sorted array.
function sample1@worker1(xs: integer[]@worker1, m: integer@worker1): integer[]@worker1 {
    let out: integer[]@worker1 = []@worker1;
    for (let i = 0@worker1; i < m; i = i + 1@worker1) {
        out.push(xs[(i * xs.length) / m]);
    }
    return out;
}

// The elements of bucket b (1-based): those v with splitters[b-2] <= v < splitters[b-1].
function bucket1@worker1(xs: integer[]@worker1, splitters: integer[]@worker1, b: integer@worker1): integer[]@worker1 {
    let lo = -1@worker1;
    if (b > 1@worker1) {
        lo = splitters[b - 2@worker1];
    }
    let hi = 1000000@worker1;
    if (b <= splitters.length) {
        hi = splitters[b - 1@worker1];
    }
    let out: integer[]@worker1 = []@worker1;
    for (let i = 0@worker1; i < xs.length; i = i + 1@worker1) {
        let v = xs[i];
        if (v >= lo && v < hi) {
            out.push(v);
        }
    }
    return out;
}

function isSorted1@worker1(xs: integer[]@worker1): boolean@worker1 {
    let sorted = true@worker1;
    for (let i = 1@worker1; i < xs.length; i = i + 1@worker1) {
        if (xs[i - 1@worker1] > xs[i]) {
            sorted = false@worker1;
        }
    }
    return sorted;
}

function checksum1@worker1(xs: integer[]@worker1): integer@worker1 {
    let sum = 0@worker1;
    for (let i = 0@worker1; i < xs.length; i = i + 1@worker1) {
        sum = (sum + xs[i]) % 1000003@worker1;
    }
    return sum;
}

// The smallest element, or 1000000 for an empty array.
function lowest1@worker1(xs: integer[]@worker1): integer@worker1 {
    if (xs.length === 0@worker1) {
        return 1000000@worker1;
    }
    return xs[0@worker1];
}

// The largest element of a sorted array, or -1 for an empty one.
function highest1@worker1(xs: integer[]@worker1): integer@worker1 {
    if (xs.length === 0@worker1) {
        return -1@worker1;
    }
    return xs[xs.length - 1@worker1];
}

