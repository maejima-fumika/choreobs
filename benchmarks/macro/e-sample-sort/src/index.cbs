}

// The merge of two sorted arrays, as a fresh array.
function merge2@worker2(a: integer[]@worker2, b: integer[]@worker2): integer[]@worker2 {
    let out: integer[]@worker2 = []@worker2;
    let i = 0@worker2;
    let j = 0@worker2;
    while (i < a.length || j < b.length) {
        let takeA = j >= b.length;
        if (i < a.length && j < b.length) {
