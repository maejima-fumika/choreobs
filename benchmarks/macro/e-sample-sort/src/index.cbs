        xs[hi] = t;
        sort4(xs, lo, i - 1@worker4);
        sort4(xs, i + 1@worker4, hi);
    }
}

// The merge of two sorted arrays, as a fresh array.
function merge4@worker4(a: integer[]@worker4, b: integer[]@worker4): integer[]@worker4 {
    let out: integer[]@worker4 = []@worker4;
    let i = 0@worker4;
    let j = 0@worker4;
    while (i < a.length || j < b.length) {
        let takeA = j >= b.length;
        if (i < a.length && j < b.length) {
            takeA = a[i] <= b[j];
        }
        if (takeA) {
            out.push(a[i]);
            i = i + 1@worker4;
        } else {
            out.push(b[j]);
            j = j + 1@worker4;
