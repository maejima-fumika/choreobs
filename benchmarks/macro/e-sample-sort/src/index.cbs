// ---------------------------------------------------------------------------
// worker4: local kernels
// ---------------------------------------------------------------------------

function makeData4@worker4(n: integer@worker4, seed: integer@worker4): integer[]@worker4 {
    let xs: integer[]@worker4 = []@worker4;
    let s = seed % 65537@worker4;
    for (let i = 0@worker4; i < n; i = i + 1@worker4) {
        s = (s * 75@worker4 + 74@worker4) % 65537@worker4;
        let hi = s;
        s = (s * 75@worker4 + 74@worker4) % 65537@worker4;
