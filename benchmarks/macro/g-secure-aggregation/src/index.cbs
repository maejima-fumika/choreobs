// G secure-aggregation: federated linear regression with secure aggregation.
//
// Endpoints: server, client1, client2, client3, client4.
//
// Setup: every pair of clients agrees on a secret by Diffie-Hellman (p =
// 16381, generator 2), exchanging public keys directly, client to client,
// twelve transfers in all. Each pair's secret seeds a generator that both
// ends advance in step.
//
// Each round:
//
//   1. the server broadcasts the model (DIM weights and a bias);
//   2. each client computes the gradient on its own data, encodes it in fixed
//      point mod MODULUS, and masks each coordinate: it adds the mask it
//      shares with each higher-numbered client and subtracts the one it
//      shares with each lower-numbered client;
//   3. the server adds up the masked vectors. The masks cancel, so the sum is
//      the sum of the gradients, though no single one is revealed. The server
//      decodes it and takes a gradient step.
//
// Every VERIFY_EVERY rounds a debugging path also sends the unmasked
// encodings, so the server can check that the masks really cancelled.
//
// The gradient and loss are local kernels. Key agreement, masking,
// aggregation and the model update are choreography code, and mix integer
// modular arithmetic with float arithmetic.
//
// Self-check: every verification found the masked and unmasked sums equal,
// and the loss fell below a tenth of its initial value.
//
// Output: the server prints `ok`, the initial and final loss, and the bias
// it learned (about 1.0).

// ---------------------------------------------------------------------------
// Workload
// ---------------------------------------------------------------------------

let ROUNDS: integer@every = 30@every;
let SAMPLES: integer@every = 50@every;
let DIM: integer@every = 2@every;
let MODULUS: integer@every = 1048576@every;
let VERIFY_EVERY: integer@every = 5@every;

// ---------------------------------------------------------------------------
// client1: local kernels
// ---------------------------------------------------------------------------

function rand1@client1(rng: integer[]@client1, bound: integer@client1): integer@client1 {
    let s = (rng[0@client1] * 75@client1 + 74@client1) % 65537@client1;
    rng[0@client1] = s;
    return s % bound;
}

// base^e mod p by square-and-multiply. With p < 2^14.5 every product stays
// below 2^29.
function modpow1@client1(base: integer@client1, e: integer@client1, p: integer@client1): integer@client1 {
    let result = 1@client1;
    let b = base % p;
    let x = e;
    while (x > 0@client1) {
        if (x % 2@client1 === 1@client1) {
            result = (result * b) % p;
        }
        b = (b * b) % p;
        x = x / 2@client1;
    }
    return result;
}

// n samples of dim features in [-1, 1], flattened, followed by their targets
// y = 3 x0 - 2 x1 + 1 + noise (for dim = 2; further features get weight 0.5).
function makeData1@client1(rng: integer[]@client1, n: integer@client1, dim: integer@client1): float[]@client1 {
    let xs: float[]@client1 = []@client1;
    let ys: float[]@client1 = []@client1;
    for (let i = 0@client1; i < n; i = i + 1@client1) {
        let y = 1.0@client1;
        for (let d = 0@client1; d < dim; d = d + 1@client1) {
            let x = (rand1(rng, 2001@client1) as float) / 1000.0@client1 - 1.0@client1;
            xs.push(x);
            let weight = 0.5@client1;
            if (d === 0@client1) {
                weight = 3.0@client1;
            }
            if (d === 1@client1) {
                weight = -2.0@client1;
            }
            y = y + weight * x;
        }
        let noise = (rand1(rng, 201@client1) as float) / 1000.0@client1 - 0.1@client1;
        ys.push(y + noise);
    }
    for (let i = 0@client1; i < n; i = i + 1@client1) {
        xs.push(ys[i]);
    }
    return xs;
}

// The mean gradient of the squared error of the model w (dim weights and a
// bias) over the local data.
function gradient1@client1(data: float[]@client1, n: integer@client1, dim: integer@client1, w: float[]@client1): float[]@client1 {
    let g: float[]@client1 = []@client1;
    for (let d = 0@client1; d <= dim; d = d + 1@client1) {
        g.push(0.0@client1);
    }
    for (let i = 0@client1; i < n; i = i + 1@client1) {
        let pred = w[dim];
        for (let d = 0@client1; d < dim; d = d + 1@client1) {
            pred = pred + w[d] * data[i * dim + d];
        }
        let err = pred - data[n * dim + i];
        for (let d = 0@client1; d < dim; d = d + 1@client1) {
            g[d] = g[d] + err * data[i * dim + d];
        }
        g[dim] = g[dim] + err;
    }
    for (let d = 0@client1; d <= dim; d = d + 1@client1) {
        g[d] = g[d] / (n as float);
    }
    return g;
}

// The mean squared error of w over the local data.
function loss1@client1(data: float[]@client1, n: integer@client1, dim: integer@client1, w: float[]@client1): float@client1 {
    let total = 0.0@client1;
    for (let i = 0@client1; i < n; i = i + 1@client1) {
        let pred = w[dim];
        for (let d = 0@client1; d < dim; d = d + 1@client1) {
            pred = pred + w[d] * data[i * dim + d];
        }
        let err = pred - data[n * dim + i];
        total = total + err * err;
    }
    return total / (n as float);
}

// Fixed point: each gradient component times `scale`, as an integer mod m.
function encode1@client1(g: float[]@client1, scale: float@client1, m: integer@client1): integer[]@client1 {
    let q: integer[]@client1 = []@client1;
    for (let d = 0@client1; d < g.length; d = d + 1@client1) {
        let v = (g[d] * scale) as integer;
        q.push((v % m + m) % m);
    }
    return q;
}

