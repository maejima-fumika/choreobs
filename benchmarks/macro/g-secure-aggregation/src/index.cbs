// Fixed point: each gradient component times `scale`, as an integer mod m.
function encode2@client2(g: float[]@client2, scale: float@client2, m: integer@client2): integer[]@client2 {
    let q: integer[]@client2 = []@client2;
    for (let d = 0@client2; d < g.length; d = d + 1@client2) {
        let v = (g[d] * scale) as integer;
        q.push((v % m + m) % m);
    }
    return q;
}

