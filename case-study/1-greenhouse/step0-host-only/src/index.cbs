// Greenhouse irrigation, step 0: a plain BlueScript program.
//
// Everything runs on the host. The soil moisture is a mock that dries out and
// recovers, and the pump only prints whether it is on. No location is written,
// so every value is `dyn` (spec §omitted-locations); with `host` the only
// endpoint, that simply means the host.

function readMoisture(tick: integer): float {
    // Mock: the soil dries out by 2.5 points per tick until tick 4, and
    // recovers as fast once it has been watered.
    if (tick <= 4) {
        return 40.0 - 2.5 * (tick as float);
    }
    return 30.0 + 2.5 * ((tick - 4) as float);
}

function tooDry(moisture: float): boolean {
    return moisture < 31.0;
}

function setPump(on: boolean): void {
    print(on);
}

for (let t = 0; t < 10; t = t + 1) {
    let m = readMoisture(t);
    setPump(tooDry(m));
}
