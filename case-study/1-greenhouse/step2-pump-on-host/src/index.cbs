// Greenhouse irrigation, step 2: the pump stays on the host.
//
// Changes from step 1:
// * `tooDry` and `setPump` are local functions at `host`;
// * the reading is sent from `soil` to `host` (`m <- readMoisture(tick)`).
//
// Locating the pump without the transfer still compiles, because the `30.0`
// in `tooDry` was `dyn`, and stops at run time instead: the comparison is
// bound to `soil` and cannot be passed to the host. Once `tooDry` is at
// `host`, the same mistake is a compile error that asks for a transfer.

function readMoisture@soil(tick: integer): float {
    // Mock: the soil dries out by 2.5 points per tick until tick 4, and
    // recovers as fast once it has been watered.
    if (tick <= 4) {
        return 40.0 - 2.5 * (tick as float);
    }
    return 30.0 + 2.5 * ((tick - 4) as float);
}

function tooDry@host(moisture: float): boolean {
    return moisture < 31.0;
}

function setPump@host(on: boolean): void {
    print(on);
}

for (let t = 0; t < 10; t = t + 1) {
    let tick: integer@soil <- t;
    let m: float@host <- readMoisture(tick);
    setPump(tooDry(m));
}
