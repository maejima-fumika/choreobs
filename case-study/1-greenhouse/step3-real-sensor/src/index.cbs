// Greenhouse irrigation, step 3: the mock becomes the real probe.
//
// Changes from step 2:
// * the mock `readMoisture` is deleted, and the probe's driver is imported at
//   `soil` in its place (spec §import-declarations). Nothing else changes,
//   since the imported function has the same signature.
//
// The real probe shows two things the mock hid. Its readings jitter, so the
// pump switches on and off around the threshold (step 5). And it breaks at
// tick 6 and reads -1.0, which `tooDry` takes for very dry soil, so the pump
// runs while the soil is wet (step 4).

import@soil { readMoisture } from "./hardware/soil@soil";

function tooDry@host(moisture: float): boolean {
    return moisture < 31.0;
}

function setPump@host(on: boolean): void {
    print(on);
}

for (let t = 0; t < 10; t = t + 1) {
    let tick: integer@soil <- t;
    let m: float@host <- readMoisture(tick);
    setPump(tooDry(m));
}
