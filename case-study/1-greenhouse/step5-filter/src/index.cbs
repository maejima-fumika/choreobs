// Greenhouse irrigation, step 5: a filter node smooths the readings.
//
// Changes from step 4:
// * a `filter` endpoint, which keeps a window of readings and passes on the
//   mean of the last three;
// * the reading goes to `filter` instead of the host, and the smoothed value
//   goes on to the host. The probes and the pump do not change.
//
// Without it, the jitter of the probes switches the pump on and off around
// the threshold.

import@soil { readMoisture } from "./hardware/soil@soil";
import@backup { readMoisture as readBackup } from "./hardware/backup@backup";

function plausible@soil(moisture: float): boolean {
    return moisture >= 0.0 && moisture <= 100.0;
}

function newWindow@filter(): float[] {
    let window: float[] = [];
    return window;
}

function smooth@filter(window: float[], moisture: float): float {
    window.push(moisture);
    let k = 3;
    let from = window.length - k;
    if (from < 0) {
        from = 0;
    }
    let sum = 0.0;
    for (let i = from; i < window.length; i = i + 1) {
        sum = sum + window[i];
    }
    return sum / ((window.length - from) as float);
}

function tooDry@host(moisture: float): boolean {
    return moisture < 31.0;
}

function setPump@host(on: boolean): void {
    print(on);
}

let window = newWindow();

for (let t = 0; t < 10; t = t + 1) {
    let tick: integer@soil <- t;
    let primary = readMoisture(tick);
    let ok: boolean@every <- plausible(primary);

    let reading: float@dyn = 0.0@dyn;
    if (ok) {
        reading = primary;
    } else {
        let backupTick: integer@backup <- t;
        reading = readBackup(backupTick);
    }

    let raw: float@filter <- reading;
    let m: float@host <- smooth(window, raw);
    setPump(tooDry(m));
}
