// Stands in for the capacitive soil-moisture probe on the `soil` node. It
// replays a recorded trace, one reading per tick. Copied to the soil
// endpoint's project only.
//
// The readings jitter around the trend, and the probe breaks at tick 6: from
// then on it reads -1.0, which no real soil gives.
let trace: float[] = [39.0, 37.0, 35.5, 30.5, 32.0, 30.0, -1.0, -1.0, -1.0, -1.0];

export function readMoisture(tick: integer): float {
  return trace[tick];
}
