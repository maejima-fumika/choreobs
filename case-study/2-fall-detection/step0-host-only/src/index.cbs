// Fall detection, step 0: a plain BlueScript program.
//
// Everything runs on the host. The acceleration is a mock: the wearer is at
// rest, bumps into something at tick 3, and falls at ticks 10 and 11. A sample
// over 3 g is taken for a fall, and the tick it happened at is printed. No
// location is written, so every value is `dyn` (spec §omitted-locations).

function readAccel(tick: integer): float[] {
    // Mock: x, y and z in g. At rest, 1 g points straight down.
    let s: float[] = [0.0, 0.0, 1.0];
    if (tick === 3) {
        s = [2.2, 0.3, 2.2];
    }
    if (tick === 10) {
        s = [2.5, 1.5, 2.0];
    }
    if (tick === 11) {
        s = [2.0, 2.0, 1.8];
    }
    return s;
}

// The squared magnitude, which saves a square root.
function magnitude2(s: float[]): float {
    return s[0] * s[0] + s[1] * s[1] + s[2] * s[2];
}

function isFall(m2: float): boolean {
    return m2 > 9.0;
}

function report(tick: integer, fall: boolean): void {
    if (fall) {
        print(tick);
    }
}

for (let t = 0; t < 12; t = t + 1) {
    report(t, isFall(magnitude2(readAccel(t))));
}
