// Fall detection, step 1: the samples come from a wristband.
//
// Changes from step 0:
// * a `band` endpoint, and `readAccel` is a local function there (`@band`);
// * the detection is located at the host (`@host`), and each sample is sent
//   there whole, as a three-element array;
// * the tick is sent to both, rather than passed as the `dyn` loop counter,
//   which a call would bind to one endpoint (see the greenhouse, step 1).
//
// The samples are still the mock.

function readAccel@band(tick: integer): float[] {
    // Mock: x, y and z in g. At rest, 1 g points straight down.
    let s: float[] = [0.0, 0.0, 1.0];
    if (tick === 3) {
        s = [2.2, 0.3, 2.2];
    }
    if (tick === 10) {
        s = [2.5, 1.5, 2.0];
    }
    if (tick === 11) {
        s = [2.0, 2.0, 1.8];
    }
    return s;
}

// The squared magnitude, which saves a square root.
function magnitude2@host(s: float[]): float {
    return s[0] * s[0] + s[1] * s[1] + s[2] * s[2];
}

function isFall@host(m2: float): boolean {
    return m2 > 9.0;
}

function report@host(tick: integer, fall: boolean): void {
    if (fall) {
        print(tick);
    }
}

for (let t = 0; t < 12; t = t + 1) {
    let tick: integer@band <- t;
    let s: float[]@host <- readAccel(tick);
    let now: integer@host <- t;
    report(now, isFall(magnitude2(s)));
}
