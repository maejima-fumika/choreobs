// Fall detection, step 3: the mock becomes the band's accelerometer.
//
// Changes from step 2:
// * the accelerometer's driver is imported at `band` (spec
//   §import-declarations), and `readAccel` reads the three axes from it
//   instead of making them up. An imported signature cannot have an array
//   (spec §imported-signatures), so the driver gives one axis at a time and
//   `readAccel` builds the sample as before.
//
// The recorded trace shows what the mock hid: the wearer takes the band off
// to charge at tick 6, and the fall at ticks 10 and 11 goes unseen. Step 4
// falls back to the phone.

import@band { readAxis } from "./hardware/imu@band";

function readAccel@band(tick: integer): float[] {
    let s: float[] = [readAxis(tick, 0), readAxis(tick, 1), readAxis(tick, 2)];
    return s;
}

// The squared magnitude, which saves a square root.
function magnitude2@band(s: float[]): float {
    return s[0] * s[0] + s[1] * s[1] + s[2] * s[2];
}

function isFall@host(m2: float): boolean {
    return m2 > 9.0;
}

function report@host(tick: integer, fall: boolean): void {
    if (fall) {
        print(tick);
    }
}

for (let t = 0; t < 12; t = t + 1) {
    let tick: integer@band <- t;
    let m2: float@host <- magnitude2(readAccel(tick));
    let now: integer@host <- t;
    report(now, isFall(m2));
}
