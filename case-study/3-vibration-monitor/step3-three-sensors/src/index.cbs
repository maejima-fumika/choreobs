// Vibration monitoring, step 3: two more sensors.
//
// Changes from step 2:
// * `vib2` on the fan-end bearing and `vib3` on the gearbox, each with a
//   driver of its own, imported under its own name;
// * each reading is sent to the host, which takes the worst of the three.
//
// Each sensor is one endpoint in choreobs.json, one import, and two
// transfers. The gearbox is the part that is wearing out, but the knock on
// the drive end at tick 4 still stops the machine first.

import@vib1 { readVibration as readVib1 } from "./hardware/accel@vib1";
import@vib2 { readVibration as readVib2 } from "./hardware/accel@vib2";
import@vib3 { readVibration as readVib3 } from "./hardware/accel@vib3";

function worst@host(a: float, b: float, c: float): float {
    let m = a;
    if (b > m) {
        m = b;
    }
    if (c > m) {
        m = c;
    }
    return m;
}

function tooHigh@host(v: float): boolean {
    return v > 4.5;
}

function stopMachine@host(tick: integer): void {
    print(tick);
}

let running = true;
let t = 0;
while (running && t < 20) {
    let tick1: integer@vib1 <- t;
    let tick2: integer@vib2 <- t;
    let tick3: integer@vib3 <- t;
    let v1: float@host <- readVib1(tick1);
    let v2: float@host <- readVib2(tick2);
    let v3: float@host <- readVib3(tick3);
    let alarm: boolean@every <- tooHigh(worst(v1, v2, v3));
    if (alarm) {
        let when: integer@host <- t;
        stopMachine(when);
        running = false;
    }
    t = t + 1;
}
