// Stands in for the accelerometer on the gearbox, on the `vib3` node. It
// replays a recorded trace of vibration velocity in mm/s, one reading per
// tick. Copied to the vib3 endpoint's project only.
//
// The gearbox bearing is wearing out: its vibration grows by 0.3 per tick,
// and goes over 4.5 at tick 12.
let trace: float[] = [1.0, 1.3, 1.6, 1.9, 2.2, 2.5, 2.8, 3.1, 3.4, 3.7, 4.0, 4.3, 4.6, 4.9, 5.2, 5.5, 5.8, 6.1, 6.4, 6.7];

export function readVibration(tick: integer): float {
  return trace[tick];
}
