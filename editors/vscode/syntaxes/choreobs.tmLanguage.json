{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ChoreoBS",
  "scopeName": "source.choreobs",
  "fileTypes": ["cbs"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#locations" },
    { "include": "#function-declaration" },
    { "include": "#reserved-keywords" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#array-members" },
    { "include": "#function-calls" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" },
    { "include": "#invalid-characters" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.choreobs",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.choreobs" } },
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.choreobs" } }
        },
        {
          "name": "comment.line.double-slash.choreobs",
          "match": "(//).*$",
          "captures": { "1": { "name": "punctuation.definition.comment.choreobs" } }
        }
      ]
    },
    "strings": {
      "comment": "Spec §string-literal. A string may not span lines, so an unterminated one ends at the end of its line, as the lexer reports it.",
      "name": "string.quoted.double.choreobs",
      "begin": "\"",
      "end": "\"|$",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.choreobs" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.choreobs" } },
      "patterns": [
        { "name": "constant.character.escape.choreobs", "match": "\\\\[\"\\\\nrt]" },
        { "name": "invalid.illegal.unknown-escape.choreobs", "match": "\\\\." }
      ]
    },
    "numbers": {
      "comment": "Spec §integer-literal, §float-literal: decimal digits only, and a float needs digits on both sides of the dot.",
      "patterns": [
        { "name": "constant.numeric.float.choreobs", "match": "\\b[0-9]+\\.[0-9]+\\b" },
        { "name": "constant.numeric.integer.choreobs", "match": "\\b[0-9]+\\b" }
      ]
    },
    "locations": {
      "comment": "Spec §locations: `@` followed by `every`, `dyn` or an endpoint name. The `@` takes the scope of the location it introduces, so `@alice` reads as one unit. An endpoint name has two scopes: few themes color `variable.other.constant`, and those that do not fall back to the outer `constant.language`.",
      "patterns": [
        {
          "name": "constant.language.location.every.choreobs",
          "match": "(@)\\s*every\\b",
          "captures": { "1": { "name": "punctuation.definition.location.choreobs" } }
        },
        {
          "name": "constant.language.location.dyn.choreobs",
          "match": "(@)\\s*dyn\\b",
          "captures": { "1": { "name": "punctuation.definition.location.choreobs" } }
        },
        {
          "name": "constant.language.location.choreobs variable.other.constant.location.choreobs",
          "match": "(@)\\s*[A-Za-z_][A-Za-z0-9_]*\\b",
          "captures": { "1": { "name": "punctuation.definition.location.choreobs" } }
        },
        {
          "name": "punctuation.definition.location.choreobs",
          "match": "@"
        }
      ]
    },
    "function-declaration": {
      "match": "\\b(function)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": { "name": "storage.type.function.choreobs" },
        "2": { "name": "entity.name.function.choreobs" }
      }
    },
    "keywords": {
      "comment": "Spec §keywords, the words supported in v1. test/editors/vscode-grammar.test.ts checks these lists against the lexer.",
      "patterns": [
        { "name": "keyword.control.choreobs", "match": "\\b(?:if|else|while|for|return)\\b" },
        { "name": "storage.type.choreobs", "match": "\\b(?:function|let)\\b" },
        { "name": "keyword.operator.expression.as.choreobs", "match": "\\b(?:as)\\b" },
        { "name": "support.type.primitive.choreobs", "match": "\\b(?:integer|float|boolean|string|void)\\b" },
        { "name": "constant.language.boolean.choreobs", "match": "\\b(?:true|false)\\b" },
        { "name": "constant.language.null.choreobs", "match": "\\b(?:null)\\b" },
        { "name": "constant.language.location.choreobs", "match": "\\b(?:every|dyn)\\b" }
      ]
    },
    "reserved-keywords": {
      "comment": "Spec §keywords, the words reserved but unsupported in v1: writing one is always an error.",
      "name": "invalid.illegal.unsupported-keyword.choreobs",
      "match": "\\b(?:break|continue|const|any|undefined|async|await|class|import|export)\\b"
    },
    "builtins": {
      "comment": "Spec §print-typing. `print` is reserved (spec §reserved-runtime-names), so it never names a user function.",
      "name": "support.function.builtin.choreobs",
      "match": "\\bprint\\b"
    },
    "array-members": {
      "comment": "Spec §array-length, §array-push. `length` and `push` mean something only after a `.`.",
      "patterns": [
        {
          "match": "(\\.)\\s*(push)\\b",
          "captures": {
            "1": { "name": "punctuation.accessor.choreobs" },
            "2": { "name": "support.function.array.choreobs" }
          }
        },
        {
          "match": "(\\.)\\s*(length)\\b",
          "captures": {
            "1": { "name": "punctuation.accessor.choreobs" },
            "2": { "name": "support.variable.property.array.choreobs" }
          }
        },
        {
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "punctuation.accessor.choreobs" },
            "2": { "name": "variable.other.property.choreobs" }
          }
        }
      ]
    },
    "function-calls": {
      "comment": "Comes after the keywords, so `if (` and `while (` are not taken for calls.",
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.call.choreobs" } }
    },
    "operators": {
      "comment": "Spec §operators-and-punctuation. `<-` is matched by maximal munch as in the lexer: `a<-b` is a transfer, `a < -b` a comparison. A transfer is where communication happens, so it is scoped as control rather than as an operator, which most themes leave uncolored. `==` and `!=` are lexical errors.",
      "patterns": [
        { "name": "keyword.control.transfer.choreobs", "match": "<-" },
        { "name": "keyword.operator.comparison.choreobs", "match": "===|!==" },
        { "name": "invalid.illegal.operator.choreobs", "match": "==|!=" },
        { "name": "keyword.operator.relational.choreobs", "match": "<=|>=|<|>" },
        { "name": "keyword.operator.logical.choreobs", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.assignment.choreobs", "match": "=" },
        { "name": "keyword.operator.arithmetic.choreobs", "match": "[-+*/%]" },
        { "name": "invalid.illegal.operator.choreobs", "match": "[&|]" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.statement.choreobs", "match": ";" },
        { "name": "punctuation.separator.comma.choreobs", "match": "," },
        { "name": "punctuation.separator.colon.choreobs", "match": ":" },
        { "name": "punctuation.accessor.choreobs", "match": "\\." },
        { "name": "meta.brace.round.choreobs", "match": "[()]" },
        { "name": "meta.brace.square.choreobs", "match": "[\\[\\]]" },
        { "name": "punctuation.definition.block.choreobs", "match": "[{}]" }
      ]
    },
    "identifiers": {
      "name": "variable.other.readwrite.choreobs",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    },
    "invalid-characters": {
      "comment": "Spec §lexical-specification: any other character outside a string or comment is a lexical error. Kept in step with the lexer by test/editors/vscode-grammar.test.ts.",
      "name": "invalid.illegal.character.choreobs",
      "match": "[^ \\t\\r\\nA-Za-z0-9_(){}\\[\\],;:@+\\-*/%.!=<>&|\"]"
    }
  }
}
