// Sensor pipeline.
//
// Two sensors take readings, calibrate them locally, and hand them to a
// gateway. The gateway collects a window of samples, decides whether the
// window looks healthy, and reports the outcome to a server.

// ---------------------------------------------------------------------------
// sensor1: reading and calibration
// ---------------------------------------------------------------------------

function readRaw1@sensor1(tick: integer): float {
    // Stands in for a hardware read; the value drifts with the tick.
    let base = 21.5;
    let drift = 0.25;
    return base + drift * (tick as float);
}

function bias1@sensor1(): float {
    return 0.5;
}

function calibrate1@sensor1(raw: float): float {
    let b = bias1();
    return raw + b;
}

// ---------------------------------------------------------------------------
// sensor2: same shape, different constants
// ---------------------------------------------------------------------------

function readRaw2@sensor2(tick: integer): float {
    let base = 19.0;
    let drift = 0.4;
    return base + drift * (tick as float);
}

function bias2@sensor2(): float {
    return 0.75;
}

function calibrate2@sensor2(raw: float): float {
    let b = bias2();
    return raw + b;
}

// ---------------------------------------------------------------------------
// gateway: windowing
// ---------------------------------------------------------------------------

function emptyWindow@gateway(): float[] {
    let window: float[] = [];
    return window;
}

function record@gateway(window: float[], sample: float): void {
    window.push(sample);
}

function windowSum@gateway(window: float[]): float {
    let total = 0.0;
    for (let i = 0; i < window.length; i = i + 1) {
        total = total + window[i];
    }
    return total;
}

function windowMean@gateway(window: float[]): float {
    let n = window.length;
    if (n === 0) {
        return 0.0;
    }
    let total = windowSum(window);
    return total / (n as float);
}

function isHealthy@gateway(mean: float): boolean {
    let low = 15.0;
    let high = 30.0;
    return low < mean && mean < high;
}

// ---------------------------------------------------------------------------
// server: reporting
// ---------------------------------------------------------------------------

function newLog@server(): integer[] {
    let log: integer[] = [];
    return log;
}

function appendCode@server(log: integer[], code: integer): void {
    log.push(code);
}

function healthyCode@server(): integer {
    return 200;
}

function unhealthyCode@server(): integer {
    return 503;
}

// ---------------------------------------------------------------------------
// The choreography
// ---------------------------------------------------------------------------

let window: float[]@gateway = emptyWindow();
let log: integer[]@server = newLog();

let rounds: integer@every = 3@every;

for (let round = 0@every; round < rounds; round = round + 1@every) {
    // Each sensor reads and calibrates on its own hardware.
    let tick1: integer@sensor1 <- round;
    let raw1: float@sensor1 = readRaw1(tick1);
    let value1: float@sensor1 = calibrate1(raw1);

    let tick2: integer@sensor2 <- round;
    let raw2: float@sensor2 = readRaw2(tick2);
    let value2: float@sensor2 = calibrate2(raw2);

    // Both samples travel to the gateway.
    let atGateway1: float@gateway <- value1;
    let atGateway2: float@gateway <- value2;

    record(window, atGateway1);
    record(window, atGateway2);
}

// The gateway judges the window, then tells everyone the verdict so that all
// endpoints agree on which branch to take.
let mean: float@gateway = windowMean(window);
let healthy: boolean@gateway = isHealthy(mean);
let verdict: boolean@every <- healthy;

if (verdict) {
    let code: integer@server = healthyCode();
    appendCode(log, code);
} else {
    let code: integer@server = unhealthyCode();
    appendCode(log, code);
}
