{
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es2022",
    "declaration": true,
    "composite": true,
    "declarationMap": true,
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "rootDir": "${configDir}/src",
    "outDir": "${configDir}/dist"
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
